{
  "name": "deeptutor-desktop",
  "version": "1.6.14",
  "description": "DeepTutor desktop app — Electron shell over the DeepTutor backend + Next.js frontend",
  "main": "main.js",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:backend": "bash scripts/build-backend.sh",
    "build:backend:win": "powershell -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "dist": "electron-builder --config electron-builder.config.js --mac",
    "dist:dir": "electron-builder --config electron-builder.config.js --mac --dir",
    "dist:win": "electron-builder --config electron-builder.config.js --win",
    "dist:linux": "electron-builder --config electron-builder.config.js --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
